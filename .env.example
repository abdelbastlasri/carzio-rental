# Supabase (required for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Admin panel password (login at admin.carzio.ma/login)
ADMIN_PASSWORD=change-me

# SMTP / Email (nodemailer) — Gmail path for booking emails.
# For Gmail:
#   - SMTP_USER must be your real Gmail address
#   - SMTP_PASS must be a 16-char App Password (https://myaccount.google.com/apppasswords),
#     NOT your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional: displayed sender address (defaults to SMTP_USER).
# If different from SMTP_USER, add it as a verified "Send mail as" alias in Gmail.
SMTP_FROM=contact@carzio.ma

# Resend (primary email sender by default). Create the API key at resend.com,
# keep carzio.ma verified (DKIM + DMARC in NindoHost) to send FROM contact@carzio.ma.
# Until the domain is verified, onboarding@resend.dev can only deliver TO the Resend
# account owner — set EMAIL_PROVIDER=gmail so Gmail sends first (see below).
RESEND_FROM=Carzio <contact@carzio.ma>

# Where owner copies of booking/confirmation emails go (default: contact@carzio.ma).
ADMIN_NOTIFY_EMAIL=contact@carzio.ma

# Email provider order: 'resend' (default) or 'gmail'.
# Use 'gmail' while carzio.ma is not yet verified in Resend — otherwise customer
# emails from onboarding@resend.dev are rejected outside your own inbox.
EMAIL_PROVIDER=gmail

# Optional overrides normally stored via the admin panel (leave unset to use DB).
# RESEND_API_KEY=re_...
