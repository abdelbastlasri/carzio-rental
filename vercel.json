{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(en|fr|de|es|pl)", "destination": "/index.html" },
    { "source": "/(en|fr|de|es|pl)/(.*)", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/cars", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/faq/(.*)", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/(.*)", "destination": "/index.html" },
    { "source": "/news", "destination": "/index.html" },
    { "source": "/news/(.*)", "destination": "/index.html" },
    { "source": "/location-voiture-(.*)", "destination": "/index.html" }
  ]
}
